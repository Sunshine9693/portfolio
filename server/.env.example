# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (supports local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sana_portfolio

# JWT Secret for Secure Admin Authentication
JWT_SECRET=your_jwt_secret_here

# Admin Setup Token (Required to create the first admin user securely)
ADMIN_SETUP_TOKEN=your_admin_setup_token_here

# AI Portfolio Assistant Configuration (Optional: Gemini / OpenAI LLM API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Client URL for CORS (comma-free single origin, no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional persistent directory for uploaded files
# UPLOADS_DIR=/var/lib/sana-portfolio/uploads
