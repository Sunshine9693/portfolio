# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (supports local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sana_portfolio

# JWT Secret for Secure Admin Authentication
JWT_SECRET=your_jwt_secret_here

# Admin Setup Token (Required to create the first admin user securely)
ADMIN_SETUP_TOKEN=your_admin_setup_token_here

# AI Portfolio Assistant Configuration (Optional: Gemini / OpenAI LLM API)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Client URL for CORS
CLIENT_URL=http://localhost:5173
